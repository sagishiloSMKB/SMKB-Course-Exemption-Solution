{
  "properties": {
    "connectionReferences": {
      "shared_sharepointonline": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "smkb_SMKBSharePointConnectionUser1"
        },
        "api": {
          "name": "shared_sharepointonline"
        }
      },
      "shared_office365": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "new_sharedoffice365_c3167"
        },
        "api": {
          "name": "shared_office365"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "undefined",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "SharePoint Site URL (smkb_SharePointSiteUrl)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "smkb_SharePointSiteUrl"
          }
        },
        "Environment Name (smkb_sol_EnvironmentName)": {
          "defaultValue": "dev",
          "type": "String",
          "metadata": {
            "schemaName": "smkb_sol_EnvironmentName"
          }
        },
        "Flow Error Emails (smkb_sol_FlowErrorEmails)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "smkb_sol_FlowErrorEmails"
          }
        }
      },
      "triggers": {
        "manual": {
          "metadata": {
            "operationMetadataId": "e0000000-0045-4000-8000-000000000045"
          },
          "type": "Request",
          "kind": "PowerAppV2",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "search": {
                  "type": "string"
                },
                "status": {
                  "type": "string"
                }
              }
            }
          },
          "description": "Returns lecturers from Vouchers-LecturersDetails. Optional: status (Pending/Active/Archived) filters via OData; search (text) filters client-side on name and email."
        }
      },
      "actions": {
        "Main_Flow": {
          "actions": {
            "Build_Status_Filter": {
              "runAfter": {},
              "metadata": {
                "operationMetadataId": "e0000000-0046-4000-8000-000000000046"
              },
              "type": "Compose",
              "inputs": "@if(not(empty(coalesce(triggerBody()?['status'], ''))), concat('lecturerStatus eq ''', replace(triggerBody()?['status'], '''', ''''''), ''''), '')",
              "description": "Build OData filter string for lecturerStatus if provided; empty string means no filter."
            },
            "Get_Lecturers": {
              "runAfter": {
                "Build_Status_Filter": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "e0000000-0047-4000-8000-000000000047"
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "GetItems",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('SharePoint Site URL (smkb_SharePointSiteUrl)')",
                  "table": "Vouchers-LecturersDetails",
                  "$filter": "@outputs('Build_Status_Filter')",
                  "$top": 500
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Filter_By_Search": {
              "runAfter": {
                "Get_Lecturers": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "e0000000-0048-4000-8000-000000000048"
              },
              "type": "Query",
              "inputs": {
                "from": "@body('Get_Lecturers')?['value']",
                "where": "@or(contains(toLower(string(item()?['Title'])), toLower(coalesce(triggerBody()?['search'], ''))), contains(toLower(string(item()?['lecturerLName'])), toLower(coalesce(triggerBody()?['search'], ''))), contains(toLower(string(item()?['lecturerEmail'])), toLower(coalesce(triggerBody()?['search'], ''))))"
              },
              "description": "Post-filter by search text across first name, last name, email."
            },
            "Resolve_Results": {
              "runAfter": {
                "Filter_By_Search": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "e0000000-0049-4000-8000-000000000049"
              },
              "type": "Compose",
              "inputs": "@if(not(empty(coalesce(triggerBody()?['search'], ''))), body('Filter_By_Search'), body('Get_Lecturers')?['value'])",
              "description": "Use search-filtered array when search was provided; otherwise use raw SP results."
            },
            "Select_Lecturer_Fields": {
              "runAfter": {
                "Resolve_Results": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "e0000000-0050-4000-8000-000000000050"
              },
              "type": "Select",
              "inputs": {
                "from": "@outputs('Resolve_Results')",
                "select": {
                  "id": "@string(item()?['ID'])",
                  "lecturerFName": "@item()?['Title']",
                  "lecturerLName": "@item()?['lecturerLName']",
                  "lecturerEmail": "@item()?['lecturerEmail']",
                  "lecturerCellPhone": "@item()?['lecturerCellPhone']",
                  "lecturerID": "@item()?['lecturerID']",
                  "lecturerBirthDate": "@item()?['lecturerBirthDate']",
                  "lecturerAddress": "@item()?['lecturerAddress']",
                  "lecturerTown": "@item()?['lecturerTown']",
                  "lecturerHomePhone": "@item()?['lecturerHomePhone']",
                  "lecturerWorkPlace": "@item()?['lecturerWorkPlace']",
                  "lecturerTaxStatus": "@item()?['lecturerTaxStatus']",
                  "lecturerAcademicDegree": "@item()?['lecturerAcademicDegree']",
                  "paymentType": "@item()?['paymentType']",
                  "companyName": "@item()?['companyName']",
                  "companyNumber": "@item()?['companyNumber']",
                  "bankUpdatePending": "@item()?['bankUpdatePending']",
                  "lecturerStatus": "@item()?['lecturerStatus']",
                  "inviteSentOn": "@item()?['inviteSentOn']",
                  "registrationCompletedOn": "@item()?['registrationCompletedOn']",
                  "createdByManager": "@item()?['createdByManager']",
                  "defaultFaculty": "@item()?['defaultFaculty']",
                  "defaultDepartment": "@item()?['defaultDepartment']",
                  "defaultActivityType": "@item()?['defaultActivityType']"
                }
              },
              "description": "Whitelist lecturer fields for the manager response — keeps payload lean after removing $select from GetItems."
            },
            "Respond_to_caller": {
              "runAfter": {
                "Select_Lecturer_Fields": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "e0000000-0051-4000-8000-000000000051"
              },
              "type": "Response",
              "inputs": {
                "statusCode": 200,
                "headers": {
                  "Content-Type": "application/json"
                },
                "body": {
                  "lecturers": "@body('Select_Lecturer_Fields')"
                }
              }
            }
          },
          "runAfter": {},
          "metadata": {
            "operationMetadataId": "e0000000-0052-4000-8000-000000000052"
          },
          "type": "Scope"
        },
        "Handle_Flow_Error": {
          "actions": {
            "Check_Error_Emails_Configured": {
              "actions": {
                "Send_error_notification": {
                  "runAfter": {},
                  "metadata": {
                    "operationMetadataId": "e0000000-0053-4000-8000-000000000053"
                  },
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_office365",
                      "operationId": "SendEmailV2",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                    },
                    "parameters": {
                      "emailMessage/To": "@parameters('Flow Error Emails (smkb_sol_FlowErrorEmails)')",
                      "emailMessage/Subject": "@concat('(', toUpper(parameters('Environment Name (smkb_sol_EnvironmentName)')), ') [ERROR] smkb_sol_ManagerGetLecturers failed')",
                      "emailMessage/Body": "@concat('<p><strong>smkb_sol_ManagerGetLecturers</strong> failed in <strong>', parameters('Environment Name (smkb_sol_EnvironmentName)'), '</strong>.</p><p><strong>Run ID:</strong> ', workflow()['run']['name'], '</p>')",
                      "emailMessage/From": "noreply@smkb.ac.il",
                      "emailMessage/Importance": "High"
                    },
                    "authentication": "@parameters('$authentication')"
                  }
                }
              },
              "runAfter": {},
              "expression": "@not(empty(trim(parameters('Flow Error Emails (smkb_sol_FlowErrorEmails)'))))",
              "metadata": {
                "operationMetadataId": "e0000000-0054-4000-8000-000000000054"
              },
              "type": "If"
            },
            "Respond_with_error": {
              "runAfter": {
                "Check_Error_Emails_Configured": [
                  "Succeeded",
                  "Failed",
                  "Skipped"
                ]
              },
              "metadata": {
                "operationMetadataId": "e0000000-0055-4000-8000-000000000055"
              },
              "type": "Response",
              "inputs": {
                "statusCode": 500,
                "headers": {
                  "Content-Type": "application/json"
                },
                "body": {
                  "code": "ERROR"
                }
              }
            }
          },
          "runAfter": {
            "Main_Flow": [
              "Failed",
              "TimedOut",
              "Skipped"
            ]
          },
          "metadata": {
            "operationMetadataId": "e0000000-0056-4000-8000-000000000056"
          },
          "type": "Scope",
          "description": "Error handler — runs ONLY on unexpected failures in Main_Flow."
        }
      }
    },
    "templateName": ""
  },
  "schemaVersion": "1.0.0.0"
}