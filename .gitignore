# ── Build artifacts ───────────────────────────────────────────────────────────
# _dist/ — PAC CLI solution zip staging (Tables, Flows, Env Vars starters)
_dist/
# dist/  — Vite/SPA build output (Power Apps, Power Pages starters)
dist/
*.zip

# ── Node.js ───────────────────────────────────────────────────────────────────
node_modules/
*.tsbuildinfo

# ── Environment / secrets ─────────────────────────────────────────────────────
.env
.env.*
.env.local
.env.*.local

# ── Log files ─────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── PAC CLI / Power Platform exports ──────────────────────────────────────────
_temp_*/

# ── Claude Code ───────────────────────────────────────────────────────────────
# settings.json is committed (team-wide allowlist) — settings.local.json is not
.claude/settings.local.json

# ── Editor / IDE ──────────────────────────────────────────────────────────────
.vscode/
.idea/
.cursor/
.fleet/
*.code-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Power Pages ───────────────────────────────────────────────────────────────
# webfile.yml stubs are regenerated by pac pages download; don't commit them
**/powerpages/**/*.webfile.yml
# Exceptions: app bundle + favicon metadata must be committed for pac pages upload
!**/powerpages/**/web-files/app.js.webfile.yml
!**/powerpages/**/web-files/app.css.webfile.yml
!**/powerpages/**/web-files/favicon.webp.webfile.yml
# Binary fonts — loaded from design system CDN, not committed
**/powerpages/**/web-files/*.woff
**/powerpages/**/web-files/*.woff2
# Live-site download snapshot — local reference only
**/powerpages-live-check/
# GUID freshening marker — local state, prevents accidental second run
**/.guid-freshened
# Local scratch notes
**/SECURITY-TODO.md
