# ─────────────────────────────────────────────────────────────────────────────
# Local development environment variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# Your deployed Power Pages site URL (used by the Vite proxy for local dev)
VITE_PORTAL_URL=https://your-site.powerappsportals.com

# Azure AD / Entra ID — only needed for authenticated local dev via bearer auth
# See GETTING-STARTED.md Part 2 for setup instructions
VITE_TENANT_ID=
VITE_CLIENT_ID=
