{
  "name": "power-pages-vue-starter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run lint && npm run test && npm run build && npm run upload && npm run solution:sync",
    "upload": "powershell -ExecutionPolicy Bypass -File scripts/upload-code-site.ps1",
    "solution:sync": "powershell -ExecutionPolicy Bypass -File scripts/add-site-to-solution.ps1",
    "solution:check": "powershell -ExecutionPolicy Bypass -File scripts/add-site-to-solution.ps1 -Check"
  },
  "dependencies": {
    "@smkbacil/design-ui": "file:vendor/smkbacil-design-ui-0.16.1.tgz",
    "pinia": "^2.2.0",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "eslint": "^9.17.0",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^15.14.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.8",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.1.0"
  }
}
