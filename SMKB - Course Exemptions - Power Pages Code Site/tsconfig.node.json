{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true
  },
  // vitest.config.ts and eslint.config.js were type-checked by nothing at all: not by
  // tsconfig.json (which includes only src/**) and not here. A broken vitest config surfaced as
  // "0 tests found", which reads like a passing suite.
  "include": ["vite.config.ts", "vitest.config.ts", "eslint.config.js"]
}
