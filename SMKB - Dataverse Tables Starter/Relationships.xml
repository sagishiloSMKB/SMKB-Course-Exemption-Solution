<?xml version="1.0" encoding="utf-8"?>
<!--
  REFERENCE TEMPLATE — DO NOT PLACE IN Other/ — pac solution pack reads all XML files there.
  This file is for documentation only and is not imported into Dataverse.

  When you add lookup columns that link two tables, copy the <EntityRelationship>
  block below into Other/Customizations.xml inside the <EntityRelationships> element.
  Also add the lookup attribute to the referencing table's Entity.xml.

  Naming conventions (all names below are the LOWERCASE logical forms — Dataverse lowercases
  logical names; only schemaName / PhysicalName keep PascalCase. See CLAUDE.md Critical Rule 3):
    Relationship Name:  [referencing_table]_[referenced_table]
      e.g. smkb_evt_course_smkb_evt_session
    ReferencedAttributeName:  the parent table's primary key, [referenced_table]id
    ReferencingAttributeName: the lookup column's logical name on the child table

  Example: many smkb_evt_session rows each belong to one smkb_evt_course.
  Easiest path: run the /dvt-add-lookup skill instead of hand-editing.
-->
<ImportExportXml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <EntityRelationships>
    <!--
      Copy this block into Other/Customizations.xml → <EntityRelationships> for each lookup column.
      Replace `evt` with your solution short prefix.

      <EntityRelationship Name="smkb_evt_course_smkb_evt_session">
        <EntityRelationshipType>ManyToOne</EntityRelationshipType>
        <IsCustomizable>1</IsCustomizable>
        <ReferencedEntityName>smkb_evt_course</ReferencedEntityName>
        <ReferencingEntityName>smkb_evt_session</ReferencingEntityName>
        <CascadeAssign>NoCascade</CascadeAssign>
        <CascadeDelete>RemoveLink</CascadeDelete>
        <CascadeReparent>NoCascade</CascadeReparent>
        <CascadeShare>NoCascade</CascadeShare>
        <CascadeUnshare>NoCascade</CascadeUnshare>
        <CascadeRollupView>NoCascade</CascadeRollupView>
        <IsValidForAdvancedFind>1</IsValidForAdvancedFind>
        <ReferencedAttributeName>smkb_evt_courseid</ReferencedAttributeName>
        <ReferencingAttributeName>smkb_evt_courseid</ReferencingAttributeName>
        <ReferencingEntityNavigationPropertyName>smkb_evt_courseid</ReferencingEntityNavigationPropertyName>
        <ReferencedEntityNavigationPropertyName>smkb_evt_course_smkb_evt_session</ReferencedEntityNavigationPropertyName>
        <RelationshipDescription />
      </EntityRelationship>
    -->
  </EntityRelationships>
</ImportExportXml>
