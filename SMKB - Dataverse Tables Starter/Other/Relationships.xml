<?xml version="1.0" encoding="utf-8"?>
<!--
  TEMPLATE / REFERENCE — this file is not read by pac solution pack.
  When you add lookup columns that link two tables, copy the <EntityRelationship>
  block below into Other/Customizations.xml inside the <EntityRelationships> element.

  Also add the lookup attribute to the referencing table's Entity.xml.

  Naming conventions:
    Relationship Name:  [referencing_table]_[referenced_table]
      e.g. sol_registration_sol_session
    ReferencedAttributeName: [referenced_table]id  (primary key of the parent table)
    ReferencingAttributeName: [referenced_table]   (the lookup column on the child table)

  Example: many sol_registration rows each belong to one sol_session.
-->
<ImportExportXml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <EntityRelationships>
    <!--
      Copy this block into Other/Customizations.xml → <EntityRelationships> for each lookup column.

      <EntityRelationship Name="sol_registration_sol_session">
        <EntityRelationshipType>ManyToOne</EntityRelationshipType>
        <IsCustomizable>1</IsCustomizable>
        <ReferencedEntityName>sol_session</ReferencedEntityName>
        <ReferencingEntityName>sol_registration</ReferencingEntityName>
        <CascadeAssign>NoCascade</CascadeAssign>
        <CascadeDelete>RemoveLink</CascadeDelete>
        <CascadeReparent>NoCascade</CascadeReparent>
        <CascadeShare>NoCascade</CascadeShare>
        <CascadeUnshare>NoCascade</CascadeUnshare>
        <CascadeRollupView>NoCascade</CascadeRollupView>
        <IsValidForAdvancedFind>1</IsValidForAdvancedFind>
        <ReferencedAttributeName>sol_sessionid</ReferencedAttributeName>
        <ReferencingAttributeName>sol_session</ReferencingAttributeName>
        <ReferencingEntityNavigationPropertyName>sol_session_sol_registration</ReferencingEntityNavigationPropertyName>
        <ReferencedEntityNavigationPropertyName>sol_session_sol_registration_sol_session</ReferencedEntityNavigationPropertyName>
        <RelationshipDescription />
      </EntityRelationship>
    -->
  </EntityRelationships>
</ImportExportXml>
