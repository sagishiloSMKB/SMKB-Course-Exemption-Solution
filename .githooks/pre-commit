#!/bin/sh
# ─────────────────────────────────────────────────────────────────────────────
# Root pre-commit — the ONE git hook for the whole solution monorepo.
#
# The starters used to each ship their own hook; git only fires hooks from the
# repo root, so those never ran once the starters became sub-folders. This hook
# owns all pre-commit gating and dispatches by the path of each staged file:
#
#   • <starter>/**/*.{vue,ts,tsx}                 -> that starter's local eslint
#   • Power Automate Flows/{Workflows,Other}      -> flow-lint (zero-dep node)
#   • enforcement (Part C of the refactor plan)   -> doc-boundary + config drift
#
# Opt-in — git does NOT install this automatically. Enable once per clone:
#   git config core.hooksPath .githooks
#
# Every step SKIPS GRACEFULLY when its toolchain is not installed, so a fresh
# clone is never blocked before the per-starter installs have run.
# ─────────────────────────────────────────────────────────────────────────────
status=0

STAGED=$(git diff --cached --name-only --diff-filter=ACMR)

# Is this repo still the uninitialized template? (same signal apply-config.ps1 uses.)
# While uninitialized, the example flows still carry placeholders on purpose, so the
# placeholder-blocking flow-lint gate must NOT run at commit time — it runs at deploy time.
INITIALIZED=1
if [ ! -f solution.config.json ] || grep -q 'YourSolutionName' solution.config.json; then
  INITIALIZED=0
fi

# ── ESLint per code-starter (toolchain-agnostic: call the local eslint binary,
#    so it works whether the starter uses pnpm or npm) ────────────────────────
lint_starter() {
  dir="$1"
  files=$(printf '%s\n' "$STAGED" | grep -E "^${dir}/.*\.(vue|ts|tsx)$" || true)
  [ -z "$files" ] && return 0
  if [ ! -x "$dir/node_modules/.bin/eslint" ]; then
    echo "pre-commit: [$dir] eslint not installed — skipping lint (install deps to enable)"
    return 0
  fi
  rel=$(printf '%s\n' "$files" | sed "s#^${dir}/##")
  echo "pre-commit: [$dir] linting staged files ..."
  ( cd "$dir" && printf '%s\n' "$rel" | xargs -r ./node_modules/.bin/eslint ) || return 1
  return 0
}

# Match BOTH the template folder name and the renamed form (Init Project Step 7 renames every
# activated starter). Addressing only the template name made this dispatch silently inert on all
# real solution code the moment the folders moved. The globs are unquoted on purpose so the shell
# expands them; `for` does not word-split its results, so the spaces in the names are safe.
for dir in "SMKB - Power Apps Starter" "SMKB - "*" - Power App"; do
  [ -d "$dir" ] || continue
  lint_starter "$dir" || status=1
done
for dir in "SMKB - Power Pages Code Site Starter" "SMKB - "*" - Power Pages Code Site"; do
  [ -d "$dir" ] || continue
  lint_starter "$dir" || status=1
done

# ── flow-lint for the Cloud Flows starter (static JSON/XML checks) ────────────
# Only once the solution is initialized — the template's example flows carry placeholders
# on purpose, and flow-lint (correctly) blocks on those. deploy.ps1 is the placeholder gate.
for FLOWS_DIR in "SMKB - Power Automate Flows Starter" "SMKB - "*" - Cloud Flows"; do
  [ -d "$FLOWS_DIR" ] || continue
  # An anchored `case` glob, not `grep -E`: the folder name is DATA, and passing it to a regex
  # let its own characters be interpreted as pattern syntax.
  FLOW_STAGED=$(printf '%s\n' "$STAGED" | while IFS= read -r f; do
    case "$f" in
      "$FLOWS_DIR"/Workflows/*.json|"$FLOWS_DIR"/Other/*.xml) printf '%s\n' "$f" ;;
    esac
  done)
  [ "$INITIALIZED" = 1 ] && [ -n "$FLOW_STAGED" ] || continue
  if command -v node >/dev/null 2>&1 && [ -f "$FLOWS_DIR/tools/flow-lint/lint.mjs" ]; then
    echo "pre-commit: [$FLOWS_DIR] running flow-lint ..."
    node "$FLOWS_DIR/tools/flow-lint/lint.mjs" "$FLOWS_DIR/Workflows" || status=1
  else
    echo "pre-commit: [$FLOWS_DIR] node/flow-lint unavailable — skipping flow-lint"
  fi
done

# ── Enforcement: root/starter boundary + solution-config drift (Part C) ───────
if command -v node >/dev/null 2>&1 && [ -f "scripts/check-doc-boundaries.mjs" ]; then
  node "scripts/check-doc-boundaries.mjs" || status=1
fi

# ── Enforcement: the template must not trip its own guards ────────────────────
# A shipped file that documents the sentinel its own guard greps for makes that guard fire
# on its own prose and block a correct deploy. This happened four times in one real
# initialization, so it is checked mechanically. Also enforces ASCII-only .ps1 / solution XML.
if command -v node >/dev/null 2>&1 && [ -f "scripts/check-template-guards.mjs" ]; then
  node "scripts/check-template-guards.mjs" || status=1
fi

if [ -f "apply-config.ps1" ]; then
  PS=""
  if command -v pwsh >/dev/null 2>&1; then PS=pwsh
  elif command -v powershell >/dev/null 2>&1; then PS=powershell
  fi
  if [ -n "$PS" ]; then
    "$PS" -NoProfile -ExecutionPolicy Bypass -File "apply-config.ps1" -Check || status=1
  else
    echo "pre-commit: PowerShell unavailable — skipping config-drift check"
  fi
fi

if [ "$status" -ne 0 ]; then
  echo "pre-commit: checks failed — fix the issues (or stage the fixes) and re-commit."
fi
exit $status
