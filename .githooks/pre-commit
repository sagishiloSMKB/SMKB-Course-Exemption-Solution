#!/bin/sh
# ─────────────────────────────────────────────────────────────────────────────
# Root pre-commit — the ONE git hook for the whole solution monorepo.
#
# The starters used to each ship their own hook; git only fires hooks from the
# repo root, so those never ran once the starters became sub-folders. This hook
# owns all pre-commit gating and dispatches by the path of each staged file:
#
#   • <starter>/**/*.{vue,ts,tsx}                 -> that starter's local eslint
#   • Power Automate Flows/{Workflows,Other}      -> flow-lint (zero-dep node)
#   • enforcement (Part C of the refactor plan)   -> doc-boundary + config drift
#
# Opt-in — git does NOT install this automatically. Enable once per clone:
#   git config core.hooksPath .githooks
#
# Every step SKIPS GRACEFULLY when its toolchain is not installed, so a fresh
# clone is never blocked before the per-starter installs have run.
# ─────────────────────────────────────────────────────────────────────────────
status=0

STAGED=$(git diff --cached --name-only --diff-filter=ACMR)

# Is this repo still the uninitialized template? While uninitialized, the example flows still
# carry placeholders on purpose, so the placeholder-blocking flow-lint gate must NOT run at
# commit time - it runs at deploy time.
#
# Delegated to scripts/is-initialized.mjs so this agrees with CI and with apply-config.ps1. The
# grep this replaced tested ONLY the unique name, so a config with the name typed and the prefix
# still "sol" read INITIALIZED here and UNINITIALIZED to apply-config.ps1 -Check. Any answer but
# a clean exit 0 means "not initialized", which is the safe direction: the gate is skipped.
INITIALIZED=0
if command -v node >/dev/null 2>&1 && [ -f scripts/is-initialized.mjs ]; then
  node scripts/is-initialized.mjs && INITIALIZED=1
elif [ -f solution.config.json ] && ! grep -q 'YourSolutionName' solution.config.json; then
  # No Node: fall back to the weaker signal rather than skipping every gate silently.
  echo "pre-commit: node unavailable - using the weaker initialized check"
  INITIALIZED=1
fi

# ── ESLint per code-starter (toolchain-agnostic: call the local eslint binary,
#    so it works whether the starter uses pnpm or npm) ────────────────────────
lint_starter() {
  dir="$1"
  files=$(printf '%s\n' "$STAGED" | grep -E "^${dir}/.*\.(vue|ts|tsx)$" || true)
  [ -z "$files" ] && return 0
  if [ ! -x "$dir/node_modules/.bin/eslint" ]; then
    echo "pre-commit: [$dir] eslint not installed — skipping lint (install deps to enable)"
    return 0
  fi
  rel=$(printf '%s\n' "$files" | sed "s#^${dir}/##")
  echo "pre-commit: [$dir] linting staged files ..."
  # -d '\n' so a staged path containing a SPACE is one argument. Plain `xargs` splits on
  # whitespace, so "src/views/My View.vue" arrived as two nonexistent paths and eslint failed
  # with "No files matching the pattern" - a lint error about a file that is not the problem.
  ( cd "$dir" && printf '%s\n' "$rel" | xargs -r -d '\n' ./node_modules/.bin/eslint ) || return 1
  return 0
}

# Match BOTH the template folder name and the renamed form (Init Project Phase 6 renames every
# activated starter). Addressing only the template name made this dispatch silently inert on all
# real solution code the moment the folders moved. The globs are unquoted on purpose so the shell
# expands them; `for` does not word-split its results, so the spaces in the names are safe.
for dir in "SMKB - Power Apps Starter" "SMKB - "*" - Power App"; do
  [ -d "$dir" ] || continue
  lint_starter "$dir" || status=1
done
for dir in "SMKB - Power Pages Code Site Starter" "SMKB - "*" - Power Pages Code Site"; do
  [ -d "$dir" ] || continue
  lint_starter "$dir" || status=1
done

# ── flow-lint for the Cloud Flows starter (static JSON/XML checks) ────────────
# Only once the solution is initialized — the template's example flows carry placeholders
# on purpose, and flow-lint (correctly) blocks on those. deploy.ps1 is the placeholder gate.
#
# Run with --pre-commit, which skips ONLY the placeholder rules (see DEPLOY_TIME_RULE_IDS in
# rules.mjs). Without it, the whole Init Project build phase was uncommittable: INITIALIZED
# flips at Phase 2.2, lint.mjs scans the whole Workflows folder, and the still-untouched
# example skeletons plus Other/*.xml then rejected any commit that staged a flow — 11 errors,
# 9 from files the developer never staged. Every other rule (the three-file rule, secrets,
# auth-token validation, secureData, $authentication) still runs here.
for FLOWS_DIR in "SMKB - Power Automate Flows Starter" "SMKB - "*" - Cloud Flows"; do
  [ -d "$FLOWS_DIR" ] || continue
  # An anchored `case` glob, not `grep -E`: the folder name is DATA, and passing it to a regex
  # let its own characters be interpreted as pattern syntax.
  FLOW_STAGED=$(printf '%s\n' "$STAGED" | while IFS= read -r f; do
    case "$f" in
      "$FLOWS_DIR"/Workflows/*.json|"$FLOWS_DIR"/Other/*.xml) printf '%s\n' "$f" ;;
    esac
  done)
  [ "$INITIALIZED" = 1 ] && [ -n "$FLOW_STAGED" ] || continue
  if command -v node >/dev/null 2>&1 && [ -f "$FLOWS_DIR/tools/flow-lint/lint.mjs" ]; then
    echo "pre-commit: [$FLOWS_DIR] running flow-lint ..."
    node "$FLOWS_DIR/tools/flow-lint/lint.mjs" --pre-commit "$FLOWS_DIR/Workflows" || status=1
    # ── The deploy-time rules, WARN-ONLY (added 2026-08-30) ─────────────────────
    # The skip above is deliberate and stays. But it made the placeholder gates INVISIBLE
    # locally, not merely non-blocking: every local run printed "0 errors, clean" while CI
    # failed on exactly those two rules for 10 consecutive commits. A skip line nobody reads
    # is not disclosure.
    #
    # So run them again as a REPORT. `|| true` - this must never block a commit, because a
    # half-built solution legitimately carries placeholders for the whole of Phase 7. The
    # point is that `smkb_sol_` in an ACTIVATED starter is now visible at the moment you
    # commit, instead of being discovered in CI days later.
    echo "pre-commit: [$FLOWS_DIR] deploy-time placeholder rules (warn-only, never blocks) ..."
    node "$FLOWS_DIR/tools/flow-lint/lint.mjs" \
         --only=no-placeholders,xml-no-placeholders "$FLOWS_DIR/Workflows" || true
  else
    echo "pre-commit: [$FLOWS_DIR] node/flow-lint unavailable — skipping flow-lint"
  fi
done

# ── Enforcement: root/starter boundary + solution-config drift (Part C) ───────
if command -v node >/dev/null 2>&1 && [ -f "scripts/check-doc-boundaries.mjs" ]; then
  node "scripts/check-doc-boundaries.mjs" || status=1
fi

# ── Enforcement: the template must not trip its own guards ────────────────────
# A shipped file that documents the sentinel its own guard greps for makes that guard fire
# on its own prose and block a correct deploy. This happened four times in one real
# initialization, so it is checked mechanically. Also enforces ASCII-only .ps1 / solution XML.
if command -v node >/dev/null 2>&1 && [ -f "scripts/check-template-guards.mjs" ]; then
  node "scripts/check-template-guards.mjs" || status=1
fi

# --- LOCAL PATCH (2026-08-26) - deliberate divergence from the starter kit ------------------
# `command -v powershell` proves the FILE EXISTS on PATH; it does not prove it RUNS. On this
# machine Windows PowerShell is present at C:\WINDOWS\System32\... but Group Policy blocks
# execution, so PS was set, the real call died with "Permission denied", status=1, and EVERY
# commit in the repo was rejected - for an environmental reason unrelated to the change being
# committed. The graceful-skip branch below was unreachable.
# The kit models "absent or working". This machine is a third state: present but not runnable.
# Probe with a cheap no-op instead, and make the skip LOUD so a missing gate never reads as a
# pass. See STARTER_AGENT_FEEDBACK_AND_NOTES.md - "toolchain probes test existence, not
# executability".
# --------------------------------------------------------------------------------------------
if [ -f "apply-config.ps1" ]; then
  # Exists AND executes. `-Command exit 0` touches nothing in the repo and is not subject to
  # execution policy, so it can only fail for interpreter-level reasons (absent, blocked,
  # broken install) - never for a real config-drift finding. Drift is still decided solely by
  # the real invocation below, whose exit code is unchanged.
  ps_runs() {
    command -v "$1" >/dev/null 2>&1 || return 1
    "$1" -NoProfile -Command exit 0 >/dev/null 2>&1
  }
  PS=""
  PS_WHY="is not installed"
  if ps_runs pwsh; then PS=pwsh
  elif ps_runs powershell; then PS=powershell
  elif command -v pwsh >/dev/null 2>&1 || command -v powershell >/dev/null 2>&1; then
    PS_WHY="is present but will not run (blocked by policy, or a broken install)"
  fi
  if [ -n "$PS" ]; then
    "$PS" -NoProfile -ExecutionPolicy Bypass -File "apply-config.ps1" -Check || status=1
  else
    echo "pre-commit: WARNING - PowerShell $PS_WHY."
    echo "pre-commit: SKIPPING the config-drift check (apply-config.ps1 -Check)."
    echo "pre-commit: identity drift between solution.config.json and the starters is NOT being caught."
  fi
fi

if [ "$status" -ne 0 ]; then
  echo "pre-commit: checks failed — fix the issues (or stage the fixes) and re-commit."
fi
exit $status
