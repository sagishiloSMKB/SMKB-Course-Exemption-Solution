# Power Pages Starter — patterns specific to this starter only.
# All common patterns (node_modules, dist, logs, IDE, OS) are in the root .gitignore.

# Environment files — must be here (not just root) because security-check.mjs resolves
# repoRoot relative to this starter folder and reads this .gitignore directly.
.env
.env.*
.env*.local

# PAC CLI download artifacts — webfile.yml stubs are regenerated by pac pages download.
# Binary web files are NOT committed; only the YAML metadata stubs are tracked.
powerpages/**/*.webfile.yml
# Exceptions: app bundle + favicon metadata must be committed so pac pages upload can register assets
!powerpages/**/web-files/app.js.webfile.yml
!powerpages/**/web-files/app.css.webfile.yml
!powerpages/**/web-files/favicon.webp.webfile.yml

# Binary font files — not committed; fonts are loaded from the design system CDN
powerpages/**/web-files/*.woff
powerpages/**/web-files/*.woff2

# Live-site snapshot — read-only reference, regenerable via pac pages download
powerpages-live-check/

# Local scratch notes
SECURITY-TODO.md
