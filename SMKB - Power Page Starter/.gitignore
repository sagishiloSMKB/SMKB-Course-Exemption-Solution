# Dependencies
client/node_modules/

# Build output
client/dist/

# Vite caches
client/node_modules/.vite/
client/node_modules/.cache/
client/node_modules/.tmp/

# Environment overrides (may contain local secrets)
client/.env.local
client/.env.*.local

# TypeScript build info
*.tsbuildinfo

# PAC CLI download artifacts — regenerated by `pac pages download`, not hand-authored
powerpages/**/*.webfile.yml
# Exception: app bundle metadata must be committed so pac pages upload can register the assets
!powerpages/**/web-files/app.js.webfile.yml
!powerpages/**/web-files/app.css.webfile.yml
!powerpages/**/web-files/favicon.webp.webfile.yml
# Binary web files tracked by webfile.yml — exclude the raw binaries, keep the YMLs
powerpages/**/web-files/*.woff
powerpages/**/web-files/*.woff2

# Live-site snapshot — read-only reference material, regenerable via `pac pages download`
powerpages-live-check/

# Editor / IDE
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local notes
SECURITY-TODO.md

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
