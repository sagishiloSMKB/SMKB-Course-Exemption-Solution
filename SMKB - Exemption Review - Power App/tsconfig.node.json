{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  // vitest.config.ts and eslint.config.js were type-checked by nothing: not by tsconfig.app.json
  // (src/** only) and not here. A broken vitest config reports "0 tests found", which reads like
  // a green suite.
  "include": ["vite.config.ts", "vitest.config.ts", "eslint.config.js"]
}
