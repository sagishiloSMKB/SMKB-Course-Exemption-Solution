{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "connection": {
          "connectionReferenceLogicalName": "msdyn_Dataverse"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        },
        "runtimeSource": "embedded"
      },
      "shared_office365_sol": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "new_sharedoffice365_c3167"
        },
        "api": {
          "name": "shared_office365"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "ENVIRONMENT_NAME (smkb_sol_EnvironmentName)": {
          "defaultValue": "dev",
          "type": "String",
          "metadata": {
            "schemaName": "smkb_sol_EnvironmentName",
            "description": "Logical environment name (dev/stage/prod). Prefixes email subjects outside prod."
          }
        },
        "ERROR_EMAILS (smkb_sol_FlowErrorEmails)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "smkb_sol_FlowErrorEmails",
            "description": "Semicolon-separated email addresses for flow error notifications."
          }
        }
      },
      "triggers": {
        "manual": {
          "metadata": {
            "operationMetadataId": "1b2c3d4e-5f6a-4b7c-8d9e-0f1a2b3c4d5e"
          },
          "type": "Request",
          "kind": "PowerAppV2",
          "description": "Power Apps Code App trigger (V2). After deploy, register with pnpm pa add-flow --flow-id <PA flow id>. Replace the input schema with your fields (use PowerAppV2, not PowerApps).",
          "inputs": {
            "schema": {
              "type": "object",
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "type": "integer",
                  "description": "REPLACE: example input - e.g. a Dataverse row id sent by the Code App"
                }
              }
            }
          }
        }
      },
      "actions": {
        "Main_Flow": {
          "type": "Scope",
          "description": "Wrap ALL business logic in this Scope so Handle_Flow_Error can catch failures via runAfter. Replace List_records with your logic; keep a final Response.",
          "actions": {
            "List_records": {
              "type": "OpenApiConnection",
              "description": "Read rows from Dataverse. entityName is the table PLURAL LOGICAL name (lowercase) - e.g. a table smkb_prc_Placement has the set smkb_prc_placements. Dataverse is the data platform; see CLAUDE.md Critical Rule 6.",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "ListRecords",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "[REPLACE-WITH-YOUR-TABLE-PLURAL-LOGICAL-NAME]",
                  "$top": 10
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {}
            },
            "Respond_to_caller": {
              "type": "Response",
              "description": "Return JSON to the Code App. Unlike Power Pages, PowerAppV2 flows may use non-2xx for errors - the Code App reads the HTTP status directly.",
              "inputs": {
                "statusCode": 200,
                "headers": {
                  "Content-Type": "application/json"
                },
                "body": {
                  "items": "@body('List_records')?['value']"
                }
              },
              "runAfter": {
                "List_records": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {}
        },
        "Handle_Flow_Error": {
          "type": "Scope",
          "description": "Error handler - runs ONLY on unexpected failures in Main_Flow. Emails ERROR_EMAILS (if set), then returns 500 so the Code App surfaces the failure.",
          "actions": {
            "Check_Error_Emails_Configured": {
              "type": "If",
              "expression": "@not(empty(trim(parameters('ERROR_EMAILS (smkb_sol_FlowErrorEmails)'))))",
              "actions": {
                "Send_error_notification": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_office365_sol",
                      "operationId": "SendEmailV2",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                    },
                    "parameters": {
                      "emailMessage/To": "@parameters('ERROR_EMAILS (smkb_sol_FlowErrorEmails)')",
                      "emailMessage/Subject": "@concat('(', toUpper(parameters('ENVIRONMENT_NAME (smkb_sol_EnvironmentName)')), ') [ERROR] smkb_sol_ExampleFlowPowerAppV2 failed')",
                      "emailMessage/Body": "@concat('<p><strong>smkb_sol_ExampleFlowPowerAppV2</strong> failed in <strong>', parameters('ENVIRONMENT_NAME (smkb_sol_EnvironmentName)'), '</strong>.</p><p><strong>Run ID:</strong> ', workflow()['run']['name'], '</p>')",
                      "emailMessage/From": "noreply@smkb.ac.il",
                      "emailMessage/Importance": "High"
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runAfter": {}
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {}
            },
            "Respond_with_error": {
              "type": "Response",
              "inputs": {
                "statusCode": 500,
                "headers": {
                  "Content-Type": "application/json"
                },
                "body": {
                  "code": "ERROR"
                }
              },
              "runAfter": {
                "Check_Error_Emails_Configured": [
                  "Succeeded",
                  "Failed",
                  "Skipped"
                ]
              }
            }
          },
          "runAfter": {
            "Main_Flow": [
              "Failed",
              "TimedOut",
              "Skipped"
            ]
          }
        }
      }
    },
    "templateName": ""
  },
  "schemaVersion": "1.0.0.0"
}
