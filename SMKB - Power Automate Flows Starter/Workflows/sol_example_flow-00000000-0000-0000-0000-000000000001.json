{
  "schemaVersion": "1.0.0.0",
  "properties": {
    "connectionReferences": {
      "shared_office365_[yourid]": {
        "runtimeSource": "invoker",
        "connection": {},
        "api": {
          "name": "shared_office365"
        }
      },
      "shared_commondataserviceforapps_[yourid]": {
        "runtimeSource": "invoker",
        "connection": {},
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      }
    },
    "templateName": "",
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "undefined",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "ENVIRONMENT_NAME (sol_ENVIRONMENT_NAME)": {
          "defaultValue": "dev",
          "type": "String",
          "metadata": {
            "schemaName": "sol_ENVIRONMENT_NAME",
            "description": "Logical environment name (dev/stage/prod). Used to prefix email subjects in non-production environments."
          }
        },
        "ERROR_EMAILS (sol_FLOW_ERROR_EMAILS)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "sol_FLOW_ERROR_EMAILS",
            "description": "Semicolon-separated email addresses for flow error notifications."
          }
        }
      },
      "triggers": {
        "manual": {
          "type": "Request",
          "kind": "PowerPages",
          "description": "Power Pages trigger — only callable from your Power Pages site. Replace input schema properties with the fields your site will POST.",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "recipient": {
                  "type": "string",
                  "description": "REPLACE: email address of the recipient"
                },
                "exampleParam": {
                  "type": "string",
                  "description": "REPLACE: add or remove parameters as needed"
                }
              },
              "required": [
                "recipient"
              ]
            }
          }
        }
      },
      "actions": {
        "Main_Flow": {
          "type": "Scope",
          "description": "Wrap all main flow logic in a Scope so the error handler can target it with runAfter on Failed/TimedOut.",
          "actions": {
            "Send_an_email": {
              "type": "OpenApiConnection",
              "description": "REPLACE: update connectionName, From address, Subject, and Body for your solution. Subject is auto-prefixed with '(DEV)' or '(STAGE)' in non-production environments via the sol_ENVIRONMENT_NAME env var.",
              "inputs": {
                "host": {
                  "connectionName": "shared_office365_[yourid]",
                  "operationId": "SendEmailV2",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                },
                "parameters": {
                  "emailMessage/From": "[sol]NoReply@yourdomain.com",
                  "emailMessage/To": "@triggerBody()?['recipient']",
                  "emailMessage/Subject": "@if(equals(parameters('ENVIRONMENT_NAME (sol_ENVIRONMENT_NAME)'), 'prod'), '[REPLACE: email subject]', concat('(', toUpper(parameters('ENVIRONMENT_NAME (sol_ENVIRONMENT_NAME)')), ') [REPLACE: email subject]'))",
                  "emailMessage/Body": "<p>[REPLACE: email body HTML]</p>",
                  "emailMessage/Importance": "Normal"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {}
            },
            "Respond_to_PowerPages": {
              "type": "Response",
              "description": "Return success response to the Power Pages caller.",
              "inputs": {
                "statusCode": 200,
                "body": {
                  "status": "ok"
                }
              },
              "runAfter": {
                "Send_an_email": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {}
        },
        "Handle_Flow_Error": {
          "type": "Scope",
          "description": "Error handler — runs when Main_Flow fails or times out. Notifies sol_FLOW_ERROR_EMAILS and returns an error response so the Power Pages caller does not hang.",
          "actions": {
            "Send_error_notification": {
              "type": "OpenApiConnection",
              "description": "Send error alert to all addresses in sol_FLOW_ERROR_EMAILS (semicolon-separated String env var — no JSON parsing needed).",
              "inputs": {
                "host": {
                  "connectionName": "shared_office365_[yourid]",
                  "operationId": "SendEmailV2",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                },
                "parameters": {
                  "emailMessage/From": "[sol]NoReply@yourdomain.com",
                  "emailMessage/To": "@parameters('ERROR_EMAILS (sol_FLOW_ERROR_EMAILS)')",
                  "emailMessage/Subject": "@concat('(', toUpper(parameters('ENVIRONMENT_NAME (sol_ENVIRONMENT_NAME)')), ') [ERROR] sol_example_flow failed')",
                  "emailMessage/Body": "@concat('<p>The flow <strong>sol_example_flow</strong> failed in the <strong>', parameters('ENVIRONMENT_NAME (sol_ENVIRONMENT_NAME)'), '</strong> environment.</p><p>Run ID: ', workflow()['run']['name'], '</p><p>Check the flow run history in Power Automate for details.</p>')",
                  "emailMessage/Importance": "High"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {}
            },
            "Respond_with_error": {
              "type": "Response",
              "description": "Always return an error response so the Power Pages caller does not hang waiting for a response that will never come.",
              "inputs": {
                "statusCode": 500,
                "body": {
                  "status": "error"
                }
              },
              "runAfter": {
                "Send_error_notification": [
                  "Succeeded",
                  "Failed",
                  "Skipped"
                ]
              }
            }
          },
          "runAfter": {
            "Main_Flow": [
              "Failed",
              "TimedOut",
              "Skipped"
            ]
          }
        }
      }
    }
  }
}
