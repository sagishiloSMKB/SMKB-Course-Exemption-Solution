  <Workflows>
    <!--
      THE THREE-FILE RULE: every flow must be registered in THREE places or the deploy fails
      with "component not declared in the solution file as a root component":
        1. Workflows/<name>-<GUID>.json          the flow definition
        2. Other/Customizations.xml              a <Workflow WorkflowId="{GUID}"> entry (this file)
        3. Other/Solution.xml                    a <RootComponent type="29" id="{GUID}"> entry
      The GUID must be identical (lowercase, braces in XML) in all three.

      NOTE: <Workflows> is NOT childless. An earlier draft of this starter said it should be -
      that was wrong. Without a <Workflow> entry the JSON ships in the zip but Dataverse never
      creates the Workflow record.

      Field values below are the standard Cloud Flow settings:
        Type=1 (Modern)  Category=5 (Cloud Flow)  Scope=4 (Organization)
        StateCode=1 / StatusCode=2 (Active)
    -->
    <Workflow WorkflowId="{00000000-0000-0000-0000-000000000001}" Name="SOL - Example Flow (Power Pages)">
      <JsonFileName>/Workflows/smkb_sol_ExampleFlowPowerPages-00000000-0000-0000-0000-000000000001.json</JsonFileName>
      <Type>1</Type>
      <Subprocess>0</Subprocess>
      <Category>5</Category>
      <Mode>0</Mode>
      <Scope>4</Scope>
      <OnDemand>0</OnDemand>
      <TriggerOnCreate>0</TriggerOnCreate>
      <TriggerOnDelete>0</TriggerOnDelete>
      <AsyncAutodelete>0</AsyncAutodelete>
      <SyncWorkflowLogOnFailure>0</SyncWorkflowLogOnFailure>
      <StateCode>1</StateCode>
      <StatusCode>2</StatusCode>
      <RunAs>1</RunAs>
      <IsTransacted>1</IsTransacted>
      <IntroducedVersion>1.0.0.0</IntroducedVersion>
      <IsCustomizable>1</IsCustomizable>
      <BusinessProcessType>0</BusinessProcessType>
      <IsCustomProcessingStepAllowedForOtherPublishers>1</IsCustomProcessingStepAllowedForOtherPublishers>
      <PrimaryEntity>none</PrimaryEntity>
      <LocalizedNames>
        <LocalizedName languagecode="1033" description="SOL - Example Flow (Power Pages)" />
      </LocalizedNames>
    </Workflow>
    <Workflow WorkflowId="{00000000-0000-0000-0000-000000000002}" Name="SOL - Example Flow (Power Apps V2)">
      <JsonFileName>/Workflows/smkb_sol_ExampleFlowPowerAppV2-00000000-0000-0000-0000-000000000002.json</JsonFileName>
      <Type>1</Type>
      <Subprocess>0</Subprocess>
      <Category>5</Category>
      <Mode>0</Mode>
      <Scope>4</Scope>
      <OnDemand>0</OnDemand>
      <TriggerOnCreate>0</TriggerOnCreate>
      <TriggerOnDelete>0</TriggerOnDelete>
      <AsyncAutodelete>0</AsyncAutodelete>
      <SyncWorkflowLogOnFailure>0</SyncWorkflowLogOnFailure>
      <StateCode>1</StateCode>
      <StatusCode>2</StatusCode>
      <RunAs>1</RunAs>
      <IsTransacted>1</IsTransacted>
      <IntroducedVersion>1.0.0.0</IntroducedVersion>
      <IsCustomizable>1</IsCustomizable>
      <BusinessProcessType>0</BusinessProcessType>
      <IsCustomProcessingStepAllowedForOtherPublishers>1</IsCustomProcessingStepAllowedForOtherPublishers>
      <PrimaryEntity>none</PrimaryEntity>
      <LocalizedNames>
        <LocalizedName languagecode="1033" description="SOL - Example Flow (Power Apps V2)" />
      </LocalizedNames>
    </Workflow>
