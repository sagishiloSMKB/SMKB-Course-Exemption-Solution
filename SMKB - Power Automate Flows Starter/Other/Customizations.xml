  <!--
    SMKB CONNECTION-REFERENCE BANK - environment-level shared resources. Never create a per-solution
    copy of these; reuse the exact logical names below. This block deploys the connection-reference
    METADATA alongside the flows. List one <connectionreference> per CONNECTOR TYPE your flows use.

    All FOUR SMKB bank connectors are declared below - this folder IS the bank. Leave them all in
    place; if your solution's flows genuinely never touch a connector you may delete that one entry,
    but keeping the full bank is the default so every flow can reference it without re-adding metadata.

    | Local key hint  ->  Logical name (put in flow JSON)  | Display name      | Connector                       |
    | shared_office365       -> new_sharedoffice365_c3167          | SMKB - Outlook    | shared_office365                |
    | shared_sharepointonline-> smkb_SMKBSharePointConnectionUser1 | SMKB - SharePoint | shared_sharepointonline         |
    | shared_commondataservice-> msdyn_Dataverse                   | SMKB - Dataverse  | shared_commondataserviceforapps |
    | shared_approvals       -> smkb_SMKBApprovals                 | SMKB - Approvals  | shared_approvals                |
  -->
  <connectionreferences>
    <connectionreference connectionreferencelogicalname="new_sharedoffice365_c3167">
      <connectionreferencedisplayname>SMKB - Outlook</connectionreferencedisplayname>
      <connectorid>/providers/Microsoft.PowerApps/apis/shared_office365</connectorid>
      <iscustomizable>1</iscustomizable>
      <promptingbehavior>0</promptingbehavior>
      <statecode>0</statecode>
      <statuscode>1</statuscode>
    </connectionreference>
    <connectionreference connectionreferencelogicalname="smkb_SMKBSharePointConnectionUser1">
      <connectionreferencedisplayname>SMKB - SharePoint</connectionreferencedisplayname>
      <connectorid>/providers/Microsoft.PowerApps/apis/shared_sharepointonline</connectorid>
      <iscustomizable>1</iscustomizable>
      <promptingbehavior>0</promptingbehavior>
      <statecode>0</statecode>
      <statuscode>1</statuscode>
    </connectionreference>
    <connectionreference connectionreferencelogicalname="msdyn_Dataverse">
      <connectionreferencedisplayname>SMKB - Dataverse</connectionreferencedisplayname>
      <connectorid>/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps</connectorid>
      <iscustomizable>1</iscustomizable>
      <promptingbehavior>0</promptingbehavior>
      <statecode>0</statecode>
      <statuscode>1</statuscode>
    </connectionreference>
    <connectionreference connectionreferencelogicalname="smkb_SMKBApprovals">
      <connectionreferencedisplayname>SMKB - Approvals</connectionreferencedisplayname>
