{
  "properties": {
    "connectionReferences": {
      "shared_sharepointonline_sol": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "smkb_SMKBSharePointConnectionUser1"
        },
        "api": {
          "name": "shared_sharepointonline"
        }
      },
      "shared_office365_sol": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "new_sharedoffice365_c3167"
        },
        "api": {
          "name": "shared_office365"
        }
      },
      "shared_commondataserviceforapps": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "msdyn_Dataverse"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "SOL - SMS API URL (smkb_sol_SmsApiUrl)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "smkb_sol_SmsApiUrl"
          }
        },
        "SOL - SharePoint Site URL (smkb_SharePointSiteUrl)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "smkb_SharePointSiteUrl"
          }
        },
        "SOL - Environment Name (smkb_sol_EnvironmentName)": {
          "defaultValue": "dev",
          "type": "String",
          "metadata": {
            "schemaName": "smkb_sol_EnvironmentName"
          }
        },
        "SOL - Support Email (smkb_SupportEmail)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "smkb_SupportEmail"
          }
        },
        "SOL - SMS Sender (smkb_sol_SmsSender)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "smkb_sol_SmsSender"
          }
        },
        "SOL - Flow Error Emails (smkb_sol_FlowErrorEmails)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "smkb_sol_FlowErrorEmails"
          }
        },
        "SOL - SMS API User (smkb_sol_SmsApiUser)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "smkb_sol_SmsApiUser"
          }
        },
        "SOL - Turnstile Site Key (smkb_TurnstileSiteKey)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "smkb_TurnstileSiteKey"
          }
        }
      },
      "triggers": {
        "manual": {
          "metadata": {
            "operationMetadataId": "e0000000-0002-4000-8000-000000000002"
          },
          "type": "Request",
          "kind": "PowerPages",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "text": {
                  "title": "phone",
                  "type": "string",
                  "x-ms-dynamically-added": true,
                  "description": "Please enter your input",
                  "x-ms-content-hint": "TEXT"
                },
                "text_1": {
                  "title": "turnstileToken",
                  "type": "string",
                  "x-ms-dynamically-added": true,
                  "description": "Please enter your input",
                  "x-ms-content-hint": "TEXT"
                }
              },
              "required": [
                "text"
              ]
            }
          },
          "description": "Power Pages trigger — creates an OTP for the given phone number. Looks up the lecturer by lecturerCellPhone, sends OTP to their email, and returns masked channel values for display."
        }
      },
      "actions": {
        "Main_Flow": {
          "actions": {
            "Validate_Input": {
              "actions": {
                "Respond_invalid_input": {
                  "runAfter": {},
                  "metadata": {
                    "operationMetadataId": "e0000000-0003-4000-8000-000000000003"
                  },
                  "type": "Response",
                  "kind": "PowerPages",
                  "inputs": {
                    "statusCode": 200,
                    "headers": {
                      "Content-Type": "application/json"
                    },
                    "body": {
                      "errorCode": "INVALID_INPUT"
                    }
                  }
                },
                "Terminate_after_invalid_input": {
                  "runAfter": {
                    "Respond_invalid_input": [
                      "Succeeded"
                    ]
                  },
                  "metadata": {
                    "operationMetadataId": "e0000000-0004-4000-8000-000000000004"
                  },
                  "type": "Terminate",
                  "inputs": {
                    "runStatus": "Succeeded"
                  }
                }
              },
              "runAfter": {},
              "expression": "@empty(coalesce(triggerBody()?['text'], ''))",
              "metadata": {
                "operationMetadataId": "e0000000-0005-4000-8000-000000000005"
              },
              "type": "If",
              "description": "Guard: reject missing or empty phone number."
            },
            "If_Turnstile_Enabled": {
              "actions": {
                "GetTurnstileSecret": {
                  "runAfter": {},
                  "metadata": {
                    "operationMetadataId": "a1b2c3d4-0001-4000-8000-000000000001"
                  },
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "PerformUnboundAction",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "actionName": "RetrieveEnvironmentVariableSecretValue",
                      "item/EnvironmentVariableName": "smkb_sol_TurnstileSecretAPIKey"
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "description": "Fetch the Turnstile secret from Key Vault via the Secret env var (Secret env vars can't be read through flow parameters).",
                  "runtimeConfiguration": {
                    "secureData": {
                      "properties": [
                        "outputs"
                      ]
                    }
                  }
                },
                "Verify_Turnstile": {
                  "runAfter": {
                    "GetTurnstileSecret": [
                      "Succeeded"
                    ]
                  },
                  "metadata": {
                    "operationMetadataId": "e0000000-0006-4000-8000-000000000006"
                  },
                  "type": "Http",
                  "inputs": {
                    "method": "POST",
                    "uri": "https://challenges.cloudflare.com/turnstile/v0/siteverify",
                    "headers": {
                      "Content-Type": "application/x-www-form-urlencoded"
                    },
                    "body": "@concat('secret=', encodeUriComponent(body('GetTurnstileSecret')?['EnvironmentVariableSecretValue']), '&response=', encodeUriComponent(coalesce(triggerBody()?['text_1'], '')))"
                  },
                  "description": "POST the secret + client token to Cloudflare siteverify (form-encoded). Secure Inputs keeps the secret/token out of run history. An empty/missing token yields success:false.",
                  "runtimeConfiguration": {
                    "secureData": {
                      "properties": [
                        "inputs"
                      ]
                    }
                  }
                },
                "Parse_Turnstile_Result": {
                  "runAfter": {
                    "Verify_Turnstile": [
                      "Succeeded"
                    ]
                  },
                  "metadata": {
                    "operationMetadataId": "e0000000-0007-4000-8000-000000000007"
                  },
                  "type": "ParseJson",
                  "inputs": {
                    "content": "@body('Verify_Turnstile')",
                    "schema": {
                      "type": "object",
                      "properties": {
                        "success": {
                          "type": "boolean"
                        }
                      }
                    }
                  },
                  "description": "Parse the siteverify JSON response."
                },
                "If_Turnstile_Invalid": {
                  "actions": {
                    "Respond_captcha_failed": {
                      "runAfter": {},
                      "metadata": {
                        "operationMetadataId": "e0000000-0008-4000-8000-000000000008"
                      },
                      "type": "Response",
                      "kind": "PowerPages",
                      "inputs": {
                        "statusCode": 200,
                        "headers": {
                          "Content-Type": "application/json"
                        },
                        "body": {
                          "errorCode": "CAPTCHA_FAILED"
                        }
                      }
                    },
                    "Terminate_captcha_failed": {
                      "runAfter": {
                        "Respond_captcha_failed": [
                          "Succeeded"
                        ]
                      },
                      "metadata": {
                        "operationMetadataId": "e0000000-0009-4000-8000-000000000009"
                      },
                      "type": "Terminate",
                      "inputs": {
                        "runStatus": "Succeeded"
                      }
                    }
                  },
                  "runAfter": {
                    "Parse_Turnstile_Result": [
                      "Succeeded",
                      "Failed",
                      "Skipped"
                    ]
                  },
                  "expression": "@not(equals(body('Parse_Turnstile_Result')?['success'], true))",
                  "metadata": {
                    "operationMetadataId": "e0000000-0010-4000-8000-000000000010"
                  },
                  "type": "If",
                  "description": "Fail CLOSED: reject unless siteverify returned success:true. Also runs on Failed/Skipped (body() null -> reject), so a secret-fetch/HTTP/parse error can't let OTP through unverified. No lookup, no SMS."
                }
              },
              "runAfter": {
                "Validate_Input": [
                  "Succeeded"
                ]
              },
              "expression": "@not(empty(trim(parameters('SOL - Turnstile Site Key (smkb_TurnstileSiteKey)'))))",
              "metadata": {
                "operationMetadataId": "e0000000-0011-4000-8000-000000000011"
              },
              "type": "If",
              "description": "If Turnstile is configured (site key present), verify the captcha token with Cloudflare BEFORE any lookup/SMS. No site key = Turnstile disabled (skip)."
            },
            "Get_Lecturer_By_Phone": {
              "runAfter": {
                "If_Turnstile_Enabled": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "e0000000-0012-4000-8000-000000000012"
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline_sol",
                  "operationId": "GetItems",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('SOL - SharePoint Site URL (smkb_SharePointSiteUrl)')",
                  "table": "Vouchers-LecturersDetails",
                  "$filter": "lecturerCellPhone eq '@{replace(triggerBody()?['text'], '''', '''''')}'",
                  "$top": 1
                },
                "authentication": "@parameters('$authentication')"
              },
              "description": "Look up the lecturer row by cell phone number."
            },
            "If_Lecturer_Not_Found": {
              "actions": {
                "Respond_not_found": {
                  "runAfter": {},
                  "metadata": {
                    "operationMetadataId": "e0000000-0013-4000-8000-000000000013"
                  },
                  "type": "Response",
                  "kind": "PowerPages",
                  "inputs": {
                    "statusCode": 200,
                    "headers": {
                      "Content-Type": "application/json"
                    },
                    "body": {
                      "errorCode": "NOT_FOUND"
                    }
                  }
                },
                "Terminate_not_found": {
                  "runAfter": {
                    "Respond_not_found": [
                      "Succeeded"
                    ]
                  },
                  "metadata": {
                    "operationMetadataId": "e0000000-0014-4000-8000-000000000014"
                  },
                  "type": "Terminate",
                  "inputs": {
                    "runStatus": "Succeeded"
                  }
                }
              },
              "runAfter": {
                "Get_Lecturer_By_Phone": [
                  "Succeeded"
                ]
              },
              "expression": "@equals(length(body('Get_Lecturer_By_Phone')?['value']), 0)",
              "metadata": {
                "operationMetadataId": "e0000000-0015-4000-8000-000000000015"
              },
              "type": "If",
              "description": "No lecturer with this phone — return NOT_FOUND."
            },
            "If_Lecturer_Archived": {
              "actions": {
                "Respond_archived": {
                  "runAfter": {},
                  "metadata": {
                    "operationMetadataId": "e0000000-0016-4000-8000-000000000016"
                  },
                  "type": "Response",
                  "kind": "PowerPages",
                  "inputs": {
                    "statusCode": 200,
                    "headers": {
                      "Content-Type": "application/json"
                    },
                    "body": {
                      "errorCode": "ACCOUNT_ARCHIVED"
                    }
                  }
                },
                "Terminate_archived": {
                  "runAfter": {
                    "Respond_archived": [
                      "Succeeded"
                    ]
                  },
                  "metadata": {
                    "operationMetadataId": "e0000000-0017-4000-8000-000000000017"
                  },
                  "type": "Terminate",
                  "inputs": {
                    "runStatus": "Succeeded"
                  }
                }
              },
              "runAfter": {
                "If_Lecturer_Not_Found": [
                  "Succeeded"
                ]
              },
              "expression": "@equals(first(body('Get_Lecturer_By_Phone')?['value'])?['lecturerStatus'], 'Archived')",
              "metadata": {
                "operationMetadataId": "e0000000-0018-4000-8000-000000000018"
              },
              "type": "If",
              "description": "Block archived lecturers from logging in."
            },
            "If_Rate_Limited": {
              "actions": {
                "Respond_rate_limited": {
                  "runAfter": {},
                  "metadata": {
                    "operationMetadataId": "e0000000-0019-4000-8000-000000000019"
                  },
                  "type": "Response",
                  "kind": "PowerPages",
                  "inputs": {
                    "statusCode": 200,
                    "headers": {
                      "Content-Type": "application/json"
                    },
                    "body": {
                      "errorCode": "RATE_LIMITED"
                    }
                  }
                },
                "Terminate_rate_limited": {
                  "runAfter": {
                    "Respond_rate_limited": [
                      "Succeeded"
                    ]
                  },
                  "metadata": {
                    "operationMetadataId": "e0000000-0020-4000-8000-000000000020"
                  },
                  "type": "Terminate",
                  "inputs": {
                    "runStatus": "Succeeded"
                  }
                }
              },
              "runAfter": {
                "If_Lecturer_Archived": [
                  "Succeeded"
                ]
              },
              "expression": "@and(not(empty(coalesce(first(body('Get_Lecturer_By_Phone')?['value'])?['otpRequestedAt'], ''))), lessOrEquals(ticks(utcNow()), ticks(addMinutes(first(body('Get_Lecturer_By_Phone')?['value'])?['otpRequestedAt'], 1))))",
              "metadata": {
                "operationMetadataId": "e0000000-0021-4000-8000-000000000021"
              },
              "type": "If",
              "description": "Block if an OTP was already sent within the last 1 minute."
            },
            "Compose_OTP_Code": {
              "runAfter": {
                "If_Rate_Limited": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "e0000000-0022-4000-8000-000000000022"
              },
              "type": "Compose",
              "inputs": "@string(rand(100000, 999999))",
              "description": "Generate a random 6-digit OTP using rand(100000, 999999)."
            },
            "Patch_Lecturer_OTP_Fields": {
              "runAfter": {
                "Compose_OTP_Code": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "e0000000-0023-4000-8000-000000000023"
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline_sol",
                  "operationId": "PatchItem",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('SOL - SharePoint Site URL (smkb_SharePointSiteUrl)')",
                  "table": "Vouchers-LecturersDetails",
                  "id": "@first(body('Get_Lecturer_By_Phone')?['value'])?['ID']",
                  "item/otpCode": "@outputs('Compose_OTP_Code')",
                  "item/otpExpiresAt": "@formatDateTime(addMinutes(utcNow(), 10), 'yyyy-MM-ddTHH:mm:ssZ')",
                  "item/otpAttempts": 0,
                  "item/otpRequestedAt": "@formatDateTime(utcNow(), 'yyyy-MM-ddTHH:mm:ssZ')"
                },
                "authentication": "@parameters('$authentication')"
              },
              "description": "Write OTP fields to the lecturer's SP row."
            },
            "Compose_SMS_Message": {
              "runAfter": {
                "Patch_Lecturer_OTP_Fields": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "e0000000-0024-4000-8000-000000000024"
              },
              "type": "Compose",
              "inputs": "קוד האימות שלך לפורטל הזנת שוברים של מכללת סמינר הקיבוצים הוא @{outputs('Compose_OTP_Code')}. הקוד תקף ל-10 דקות.",
              "description": "Hebrew SMS body with the OTP code."
            },
            "GetSmsPassword": {
              "runAfter": {
                "Compose_SMS_Message": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "e0000000-0025-4000-8000-000000000025"
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "PerformUnboundAction",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "actionName": "RetrieveEnvironmentVariableSecretValue",
                  "item/EnvironmentVariableName": "smkb_sol_SmsApiPassword"
                },
                "authentication": "@parameters('$authentication')"
              },
              "description": "Fetch the the SMS provider password from Key Vault via the Secret env var.",
              "runtimeConfiguration": {
                "secureData": {
                  "properties": [
                    "outputs"
                  ]
                }
              }
            },
            "Send_OTP_SMS": {
              "runAfter": {
                "GetSmsPassword": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "e0000000-0026-4000-8000-000000000026"
              },
              "type": "Http",
              "inputs": {
                "method": "POST",
                "uri": "@concat(parameters('SOL - SMS API URL (smkb_sol_SmsApiUrl)'), '?version=1.0&operation=mt&user=', encodeUriComponent(parameters('SOL - SMS API User (smkb_sol_SmsApiUser)')), '&password=', encodeUriComponent(body('GetSmsPassword')?['EnvironmentVariableSecretValue']), '&destination=', encodeUriComponent(triggerBody()?['text']), '&source=', encodeUriComponent(parameters('SOL - SMS Sender (smkb_sol_SmsSender)')), '&message=', encodeUriComponent(outputs('Compose_SMS_Message')))"
              },
              "description": "Send the OTP via the the SMS provider gateway. Credentials/sender/url come from env vars. Secure Inputs keeps the password out of run history.",
              "runtimeConfiguration": {
                "contentTransfer": {
                  "transferMode": "Chunked"
                },
                "secureData": {
                  "properties": [
                    "inputs"
                  ]
                }
              }
            },
            "If_Has_Email": {
              "actions": {
                "Send_OTP_Email": {
                  "runAfter": {},
                  "metadata": {
                    "operationMetadataId": "e0000000-0027-4000-8000-000000000027"
                  },
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_office365_sol",
                      "operationId": "SendEmailV2",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                    },
                    "parameters": {
                      "emailMessage/To": "@first(body('Get_Lecturer_By_Phone')?['value'])?['lecturerEmail']",
                      "emailMessage/Subject": "קוד אימות - פורטל דיווח והזנת שוברים",
                      "emailMessage/Body": "@concat('<div dir=\"rtl\" style=\"direction:rtl;font-family:Arial,Helvetica,sans-serif;background:#f5f5f5;padding:32px 0;text-align:right;\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:600px;width:100%;margin:0 auto;background:#ffffff;border-radius:8px;overflow:hidden;box-shadow:0 2px 8px rgba(0,0,0,0.08);\"><tr><td style=\"background:#4eb764;padding:20px 28px;text-align:right;\"><p style=\"margin:0;color:#ffffff;font-size:20px;font-weight:bold;\">מכללת סמינר הקיבוצים</p></td></tr><tr><td style=\"padding:32px 28px;\"><p style=\"margin:0 0 8px;font-size:16px;color:#333333;\">שלום,</p><p style=\"margin:0 0 24px;font-size:15px;color:#333333;line-height:1.8;\">קוד האימות שלך לפורטל הדיווח והזנת השוברים:</p><div style=\"text-align:center;margin:0 0 24px;\"><div style=\"display:inline-block;background:#f0f7f1;border:2px solid #4eb764;border-radius:12px;padding:20px 40px;\"><p style=\"margin:0;font-size:48px;font-weight:bold;letter-spacing:10px;color:#4eb764;font-family:monospace,Arial;\">', outputs('Compose_OTP_Code'), '</p></div></div><p style=\"margin:0 0 8px;font-size:14px;color:#666666;text-align:center;\">הקוד תקף ל-10 דקות</p><p style=\"margin:0;font-size:13px;color:#999999;text-align:center;\">אם לא ביקשת קוד זה, ניתן להתעלם מאימייל זה</p></td></tr><tr><td style=\"border-top:1px solid #e5e5e5;padding:20px 28px;text-align:right;\"><p style=\"margin:0;font-size:13px;color:#666666;\">לתמיכה, אנא פנה/י לכתובת: <a href=\"mailto:', parameters('SOL - Support Email (smkb_SupportEmail)'), '\" style=\"color:#4eb764;\">', parameters('SOL - Support Email (smkb_SupportEmail)'), '</a></p></td></tr></table></div>')",
                      "emailMessage/From": "noreply@smkb.ac.il",
                      "emailMessage/Importance": "Normal"
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "description": "Send the OTP to the lecturer's email address from the lecturers list."
                }
              },
              "runAfter": {
                "Send_OTP_SMS": [
                  "Succeeded",
                  "Failed"
                ]
              },
              "expression": "@not(empty(coalesce(first(body('Get_Lecturer_By_Phone')?['value'])?['lecturerEmail'], '')))",
              "metadata": {
                "operationMetadataId": "e0000000-0028-4000-8000-000000000028"
              },
              "type": "If",
              "description": "Send the OTP by email too — only if the lecturer has an email on file."
            },
            "Compose_Channels": {
              "runAfter": {
                "If_Has_Email": [
                  "Succeeded",
                  "Failed",
                  "Skipped"
                ]
              },
              "metadata": {
                "operationMetadataId": "e0000000-0029-4000-8000-000000000029"
              },
              "type": "Compose",
              "inputs": "@union(if(equals(actions('Send_OTP_SMS')?['status'], 'Succeeded'), createArray(json(concat('{\"type\":\"sms\",\"maskedValue\":\"', concat(substring(triggerBody()?['text'], 0, 3), '****', substring(triggerBody()?['text'], sub(length(triggerBody()?['text']), 3))), '\"}'))), json('[]')), if(and(not(empty(coalesce(first(body('Get_Lecturer_By_Phone')?['value'])?['lecturerEmail'], ''))), equals(actions('Send_OTP_Email')?['status'], 'Succeeded')), createArray(json(concat('{\"type\":\"email_personal\",\"maskedValue\":\"', concat(substring(first(body('Get_Lecturer_By_Phone')?['value'])?['lecturerEmail'], 0, 2), '****', substring(first(body('Get_Lecturer_By_Phone')?['value'])?['lecturerEmail'], indexOf(first(body('Get_Lecturer_By_Phone')?['value'])?['lecturerEmail'], '@'))), '\"}'))), json('[]')))",
              "description": "Build the channels array from the deliveries that actually succeeded (sms if the SMS sent; email_personal if the lecturer has an email and it sent)."
            },
            "If_No_Channel": {
              "actions": {
                "Respond_otp_send_failed": {
                  "runAfter": {},
                  "metadata": {
                    "operationMetadataId": "e0000000-0030-4000-8000-000000000030"
                  },
                  "type": "Response",
                  "kind": "PowerPages",
                  "inputs": {
                    "statusCode": 200,
                    "headers": {
                      "Content-Type": "application/json"
                    },
                    "body": {
                      "errorCode": "OTP_SEND_FAILED"
                    }
                  }
                },
                "Terminate_otp_send_failed": {
                  "runAfter": {
                    "Respond_otp_send_failed": [
                      "Succeeded"
                    ]
                  },
                  "metadata": {
                    "operationMetadataId": "e0000000-0031-4000-8000-000000000031"
                  },
                  "type": "Terminate",
                  "inputs": {
                    "runStatus": "Succeeded"
                  }
                }
              },
              "runAfter": {
                "Compose_Channels": [
                  "Succeeded"
                ]
              },
              "else": {
                "actions": {
                  "Respond_to_PowerPages": {
                    "runAfter": {},
                    "metadata": {
                      "operationMetadataId": "e0000000-0032-4000-8000-000000000032"
                    },
                    "type": "Response",
                    "kind": "PowerPages",
                    "inputs": {
                      "statusCode": 200,
                      "headers": {
                        "Content-Type": "application/json"
                      },
                      "body": {
                        "channels": "@outputs('Compose_Channels')"
                      }
                    },
                    "description": "Return the channels that received the OTP for display in the portal OTP step."
                  }
                }
              },
              "expression": "@empty(outputs('Compose_Channels'))",
              "metadata": {
                "operationMetadataId": "e0000000-0033-4000-8000-000000000033"
              },
              "type": "If",
              "description": "If neither SMS nor email was sent successfully, return OTP_SEND_FAILED; otherwise return the channels that received the code."
            }
          },
          "runAfter": {},
          "metadata": {
            "operationMetadataId": "e0000000-0034-4000-8000-000000000034"
          },
          "type": "Scope",
          "description": "Main OTP creation logic. Business errors (NOT_FOUND, RATE_LIMITED, OTP_SEND_FAILED) use Response + Terminate(Succeeded) — they do NOT bubble up to Handle_Flow_Error."
        },
        "Handle_Flow_Error": {
          "actions": {
            "Check_Error_Emails_Configured": {
              "actions": {
                "Send_error_notification": {
                  "runAfter": {},
                  "metadata": {
                    "operationMetadataId": "e0000000-0035-4000-8000-000000000035"
                  },
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_office365_sol",
                      "operationId": "SendEmailV2",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                    },
                    "parameters": {
                      "emailMessage/To": "@parameters('SOL - Flow Error Emails (smkb_sol_FlowErrorEmails)')",
                      "emailMessage/Subject": "@concat('(', toUpper(parameters('SOL - Environment Name (smkb_sol_EnvironmentName)')), ') [ERROR] smkb_sol_CreateOtp failed')",
                      "emailMessage/Body": "@concat('<p>The flow <strong>smkb_sol_CreateOtp</strong> failed unexpectedly in <strong>', parameters('SOL - Environment Name (smkb_sol_EnvironmentName)'), '</strong>.</p><p><strong>Triggered by phone:</strong> ', coalesce(triggerBody()?['text'], '(unknown)'), '</p><p><strong>Run ID:</strong> ', workflow()['run']['name'], '</p>')",
                      "emailMessage/From": "noreply@smkb.ac.il",
                      "emailMessage/Importance": "High"
                    },
                    "authentication": "@parameters('$authentication')"
                  }
                }
              },
              "runAfter": {},
              "expression": "@not(empty(trim(parameters('SOL - Flow Error Emails (smkb_sol_FlowErrorEmails)'))))",
              "metadata": {
                "operationMetadataId": "e0000000-0036-4000-8000-000000000036"
              },
              "type": "If"
            },
            "Respond_with_error": {
              "runAfter": {
                "Check_Error_Emails_Configured": [
                  "Succeeded",
                  "Failed",
                  "Skipped"
                ]
              },
              "metadata": {
                "operationMetadataId": "e0000000-0037-4000-8000-000000000037"
              },
              "type": "Response",
              "kind": "PowerPages",
              "inputs": {
                "statusCode": 200,
                "headers": {
                  "Content-Type": "application/json"
                },
                "body": {
                  "errorCode": "OTP_SEND_FAILED"
                }
              }
            }
          },
          "runAfter": {
            "Main_Flow": [
              "Failed",
              "TimedOut",
              "Skipped"
            ]
          },
          "metadata": {
            "operationMetadataId": "e0000000-0038-4000-8000-000000000038"
          },
          "type": "Scope",
          "description": "Error handler — runs ONLY on unexpected technical failures (unhandled exception in Main_Flow)."
        }
      }
    },
