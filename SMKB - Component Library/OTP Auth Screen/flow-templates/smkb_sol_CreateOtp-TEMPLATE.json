{
  "schemaVersion": "1.0.0.0",
  "properties": {
    "connectionReferences": {
      "shared_office365_[yourid]": {
        "runtimeSource": "invoker",
        "connection": {},
        "api": {
          "name": "shared_office365"
        }
      },
      "shared_commondataserviceforapps_[yourid]": {
        "runtimeSource": "invoker",
        "connection": {},
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      }
    },
    "templateName": "",
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "undefined",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "ENVIRONMENT_NAME (smkb_sol_EnvironmentName)": {
          "defaultValue": "dev",
          "type": "String",
          "metadata": {
            "schemaName": "smkb_sol_EnvironmentName",
            "description": "Logical environment name (dev/stage/prod)."
          }
        },
        "ERROR_EMAILS (smkb_sol_FlowErrorEmails)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "smkb_sol_FlowErrorEmails",
            "description": "Semicolon-separated email addresses for flow error notifications."
          }
        },
        "TURNSTILE_SITE_KEY (smkb_sol_TurnstileSiteKey)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "description": "PUBLIC Cloudflare Turnstile site key. Empty = Turnstile not configured. In any environment other than 'dev' an empty value is treated as a MISCONFIGURATION (CONFIG_ERROR), not as 'bot protection off' - see Guard_Turnstile_Misconfigured."
          }
        },
        "OTP_DAILY_CAP (smkb_sol_OtpDailyCap)": {
          "defaultValue": 300,
          "type": "Int",
          "metadata": {
            "description": "Global cap: the maximum number of OTPs this solution will send across ALL identifiers in a rolling 24h window. Backstop against a spray across many addresses, which a per-identifier limit cannot see."
          }
        },
        "SECURITY_ALERT_EMAILS (smkb_sol_SecurityAlertEmails)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "description": "Semicolon-separated recipients alerted when the global cap trips. Empty = no alert (the cap still rejects). Never JSON - see the Env Vars README."
          }
        }
      },
      "triggers": {
        "manual": {
          "type": "Request",
          "kind": "PowerPages",
          "description": "Power Pages trigger — only callable from your Power Pages site. Registered in Power Pages site settings as SMKB/Flow/CreateOTP.",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "email": {
                  "type": "string",
                  "description": "Email address of the user requesting an OTP."
                },
                "contextId": {
                  "type": "string",
                  "description": "[ADAPT]: rename or remove if your solution has no context identifier (e.g. eventId, requestId)."
                },
                "origin": {
                  "type": "string",
                  "description": "window.location.origin from the calling client — for audit/logging."
                }
              },
              "required": [
                "email"
              ]
            }
          }
        }
      },
      "actions": {
        "Main_Flow": {
          "type": "Scope",
          "description": "All main flow logic; Handle_Flow_Error targets this scope on unexpected technical failures. Business errors (RATE_LIMITED, OTP_SEND_FAILED) use Response + Terminate(Succeeded) here and do NOT bubble up. Every Response is HTTP 200 - see RECIPE.md 'H1'.",
          "actions": {
            "Validate_Input": {
              "type": "If",
              "description": "Guard: reject missing or obviously malformed email before touching any data. Returns 200 + an errorCode, then Terminate(Succeeded) so Handle_Flow_Error does NOT run — invalid input is not a bug.",
              "expression": "@or(empty(coalesce(triggerBody()?['email'], '')), not(contains(coalesce(triggerBody()?['email'], ''), '@')))",
              "actions": {
                "Respond_invalid_input": {
                  "type": "Response",
                  "description": "Return INVALID_INPUT for a missing or malformed email. HTTP 200 - see below.",
                  "inputs": {
                    "statusCode": 200,
                    "headers": {
                      "Content-Type": "application/json"
                    },
                    "body": {
                      "errorCode": "INVALID_INPUT"
                    }
                  },
                  "runAfter": {}
                },
                "Terminate_after_invalid_input": {
                  "type": "Terminate",
                  "description": "Stop the flow cleanly — no error email.",
                  "inputs": {
                    "runStatus": "Succeeded"
                  },
                  "runAfter": {
                    "Respond_invalid_input": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {}
            },
            "Guard_Turnstile_Misconfigured": {
              "type": "If",
              "description": "MISCONFIG GUARD, runs first: no Turnstile site key and not 'dev' -> CONFIG_ERROR and stop, before any lookup or send. An unset key must never silently become an open endpoint. Opting out? Delete this AND Verify_Turnstile together.",
              "expression": {
                "and": [
                  {
                    "equals": [
                      "@empty(trim(parameters('TURNSTILE_SITE_KEY (smkb_sol_TurnstileSiteKey)')))",
                      true
                    ]
                  },
                  {
                    "not": {
                      "equals": [
                        "@toLower(trim(parameters('ENVIRONMENT_NAME (smkb_sol_EnvironmentName)')))",
                        "dev"
                      ]
                    }
                  }
                ]
              },
              "actions": {
                "Respond_config_error": {
                  "type": "Response",
                  "kind": "PowerPages",
                  "description": "HTTP 200 + errorCode, per the flow-error contract. The client maps an unknown code to its generic message, so this leaks nothing to a caller while naming the cause in run history.",
                  "inputs": {
                    "statusCode": 200,
                    "body": {
                      "errorCode": "CONFIG_ERROR"
                    }
                  }
                },
                "Terminate_after_config_error": {
                  "type": "Terminate",
                  "runAfter": {
                    "Respond_config_error": [
                      "Succeeded"
                    ]
                  },
                  "inputs": {
                    "runStatus": "Succeeded"
                  },
                  "description": "Succeeded, not Failed - a handled business outcome must not page anyone."
                }
              },
              "runAfter": {
                "Validate_Input": [
                  "Succeeded"
                ]
              }
            },
            "Verify_Turnstile": {
              "type": "Scope",
              "description": "FAIL-CLOSED bot check, before any lookup or send. Rejects unless siteverify returns success:true; the inner condition also runs on Failed/Skipped, so a fetch or parse error gives a null body and therefore a rejection. Details in RECIPE.md.",
              "runAfter": {
                "Guard_Turnstile_Misconfigured": [
                  "Succeeded"
                ]
              },
              "actions": {
                "IMPLEMENT_Verify_Turnstile": {
                  "type": "If",
                  "description": "[IMPLEMENT] Real siteverify call: Key Vault secret read (secureData outputs) -> Http POST to challenges.cloudflare.com (secureData inputs) -> ParseJson -> reject unless success is true. Keep REJECT as the default branch. Full steps in RECIPE.md.",
                  "expression": {
                    "and": [
                      {
                        "not": {
                          "equals": [
                            "@empty(trim(parameters('TURNSTILE_SITE_KEY (smkb_sol_TurnstileSiteKey)')))",
                            true
                          ]
                        }
                      }
                    ]
                  },
                  "actions": {
                    "Respond_captcha_failed": {
                      "type": "Response",
                      "kind": "PowerPages",
                      "description": "Uniform rejection - same shape as every other business error.",
                      "inputs": {
                        "statusCode": 200,
                        "body": {
                          "errorCode": "CAPTCHA_FAILED"
                        }
                      }
                    },
                    "Terminate_after_captcha_failed": {
                      "type": "Terminate",
                      "runAfter": {
                        "Respond_captcha_failed": [
                          "Succeeded"
                        ]
                      },
                      "inputs": {
                        "runStatus": "Succeeded"
                      }
                    }
                  }
                }
              }
            },
            "IMPLEMENT_List_Recent_OTP_Requests": {
              "type": "OpenApiConnection",
              "description": "Rate limiting: count OTP requests for this email in the last 10 minutes. [IMPLEMENT] Replace entityName with your OTP table's plural logical name and the email field in $filter with yours. createdon is always available. See RECIPE.md 'H1'.",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps_[yourid]",
                  "operationId": "ListRecords",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "[IMPLEMENT]: smkb_sol_otprequests",
                  "$filter": "[IMPLEMENT]: smkb_sol_email eq '@{triggerBody()?[''email'']}' and createdon ge @{addMinutes(utcNow(), -10)}",
                  "$top": 4
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "Verify_Turnstile": [
                  "Succeeded"
                ]
              }
            },
            "If_Rate_Limited": {
              "type": "If",
              "description": "Block if 3 or more OTPs were sent for this email in the last 10 minutes: 200 + RATE_LIMITED, then Terminate(Succeeded), no error email. Count per SUBMITTED identifier whether or not it exists, or RATE_LIMITED becomes an account-existence oracle.",
              "expression": "@greaterOrEquals(length(body('IMPLEMENT_List_Recent_OTP_Requests')?['value']), 3)",
              "actions": {
                "Respond_rate_limited": {
                  "type": "Response",
                  "description": "Return RATE_LIMITED. HTTP 200 - see below.",
                  "inputs": {
                    "statusCode": 200,
                    "headers": {
                      "Content-Type": "application/json"
                    },
                    "body": {
                      "errorCode": "RATE_LIMITED"
                    }
                  },
                  "runAfter": {}
                },
                "Terminate_after_rate_limit": {
                  "type": "Terminate",
                  "description": "Stop the flow cleanly — no error email.",
                  "inputs": {
                    "runStatus": "Succeeded"
                  },
                  "runAfter": {
                    "Respond_rate_limited": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "IMPLEMENT_List_Recent_OTP_Requests": [
                  "Succeeded"
                ]
              }
            },
            "If_Global_Cap_Exceeded": {
              "type": "If",
              "description": "GLOBAL CAP - the backstop a per-identifier limit cannot give you: a spray across many addresses. Rejects past OTP_DAILY_CAP with the SAME generic RATE_LIMITED code, so a caller cannot tell which limit they hit. Alert SECURITY_ALERT_EMAILS, debounced.",
              "expression": {
                "and": [
                  {
                    "greaterOrEquals": [
                      "@length(coalesce(body('IMPLEMENT_List_Recent_OTP_Requests')?['value'], json('[]')))",
                      "@parameters('OTP_DAILY_CAP (smkb_sol_OtpDailyCap)')"
                    ]
                  }
                ]
              },
              "actions": {
                "Respond_global_cap": {
                  "type": "Response",
                  "kind": "PowerPages",
                  "description": "Same generic RATE_LIMITED code as the per-identifier limit - a caller must not be able to tell which limit they hit.",
                  "inputs": {
                    "statusCode": 200,
                    "body": {
                      "errorCode": "RATE_LIMITED"
                    }
                  }
                },
                "Terminate_after_global_cap": {
                  "type": "Terminate",
                  "runAfter": {
                    "Respond_global_cap": [
                      "Succeeded"
                    ]
                  },
                  "inputs": {
                    "runStatus": "Succeeded"
                  }
                }
              },
              "runAfter": {
                "If_Rate_Limited": [
                  "Succeeded"
                ]
              }
            },
            "IMPLEMENT_PLACEHOLDER": {
              "type": "Compose",
              "description": "[IMPLEMENT - BUSINESS LOGIC] Replace this Compose with the real generate-and-send: rand(100000,999999), create the OTP row, send by SMS or email, build the masked channels array. Full steps and the two error categories: RECIPE.md 'H1'.",
              "inputs": "[IMPLEMENT]",
              "runAfter": {
                "If_Global_Cap_Exceeded": [
                  "Succeeded"
                ]
              }
            },
            "Respond_to_PowerPages": {
              "type": "Response",
              "description": "Return OTP channels to the Power Pages caller. [IMPLEMENT]: replace body.channels with your actual channels expression, e.g. @variables('channels_array').",
              "inputs": {
                "statusCode": 200,
                "headers": {
                  "Content-Type": "application/json"
                },
                "body": {
                  "channels": "[IMPLEMENT]: e.g. @variables('channels_array')"
                }
              },
              "runAfter": {
                "IMPLEMENT_PLACEHOLDER": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {}
        },
        "Handle_Flow_Error": {
          "type": "Scope",
          "description": "Error handler — runs ONLY on unexpected technical failures (unhandled exception in Main_Flow). Business errors (RATE_LIMITED, OTP_SEND_FAILED) use Terminate(Succeeded) inside Main_Flow and never reach here.",
          "actions": {
            "Check_Error_Emails_Configured": {
              "type": "If",
              "description": "Only send the error email if smkb_sol_FlowErrorEmails is configured. Skipping silently when the env var is empty avoids spurious SendEmailV2 failures that would add noise to every error handler run.",
              "expression": "@not(empty(trim(parameters('ERROR_EMAILS (smkb_sol_FlowErrorEmails)'))))",
              "actions": {
                "Send_error_notification": {
                  "type": "OpenApiConnection",
                  "description": "Send error alert to all addresses in smkb_sol_FlowErrorEmails (semicolon-separated String env var).",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_office365_[yourid]",
                      "operationId": "SendEmailV2",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                    },
                    "parameters": {
                      "emailMessage/From": "[sol]NoReply@yourdomain.com",
                      "emailMessage/To": "@parameters('ERROR_EMAILS (smkb_sol_FlowErrorEmails)')",
                      "emailMessage/Subject": "@concat('(', toUpper(parameters('ENVIRONMENT_NAME (smkb_sol_EnvironmentName)')), ') [ERROR] smkb_sol_CreateOtp failed')",
                      "emailMessage/Body": "@concat('<p>The flow <strong>smkb_sol_CreateOtp</strong> failed unexpectedly in the <strong>', parameters('ENVIRONMENT_NAME (smkb_sol_EnvironmentName)'), '</strong> environment.</p><p><strong>Triggered by:</strong> ', coalesce(triggerBody()?['email'], '(unknown)'), '</p><p><strong>Run ID:</strong> ', workflow()['run']['name'], '</p><p>Open Power Automate &#8594; Cloud flows &#8594; smkb_sol_CreateOtp &#8594; Run history to investigate.</p>')",
                      "emailMessage/Importance": "High"
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runAfter": {}
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {}
            },
            "Respond_with_error": {
              "type": "Response",
              "description": "Always return a response so the Power Pages caller does not hang. code: OTP_SEND_FAILED is what authService.ts maps to the user-facing 'could not send code' message.",
              "inputs": {
                "statusCode": 200,
                "headers": {
                  "Content-Type": "application/json"
                },
                "body": {
                  "errorCode": "OTP_SEND_FAILED"
                }
              },
              "runAfter": {
                "Check_Error_Emails_Configured": [
                  "Succeeded",
                  "Failed",
                  "Skipped"
                ]
              }
            }
          },
          "runAfter": {
            "Main_Flow": [
              "Failed",
              "TimedOut",
              "Skipped"
            ]
          }
        }
      }
    }
  }
}
