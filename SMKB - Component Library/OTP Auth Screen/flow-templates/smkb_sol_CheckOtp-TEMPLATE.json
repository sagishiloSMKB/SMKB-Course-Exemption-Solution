{
  "schemaVersion": "1.0.0.0",
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps_[yourid]": {
        "runtimeSource": "invoker",
        "connection": {},
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      },
      "shared_office365_[yourid]": {
        "runtimeSource": "invoker",
        "connection": {},
        "api": {
          "name": "shared_office365"
        }
      }
    },
    "templateName": "",
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "undefined",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "ENVIRONMENT_NAME (smkb_sol_EnvironmentName)": {
          "defaultValue": "dev",
          "type": "String",
          "metadata": {
            "schemaName": "smkb_sol_EnvironmentName",
            "description": "Logical environment name (dev/stage/prod)."
          }
        },
        "ERROR_EMAILS (smkb_sol_FlowErrorEmails)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "smkb_sol_FlowErrorEmails",
            "description": "Semicolon-separated email addresses for flow error notifications."
          }
        }
      },
      "triggers": {
        "manual": {
          "type": "Request",
          "kind": "PowerPages",
          "description": "Power Pages trigger — only callable from your Power Pages site. Registered in Power Pages site settings as SMKB/Flow/CheckOTP.",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "email": {
                  "type": "string",
                  "description": "Email address of the user submitting the OTP."
                },
                "otp": {
                  "type": "string",
                  "description": "6-digit OTP code entered by the user."
                },
                "contextId": {
                  "type": "string",
                  "description": "[ADAPT]: rename or remove to match smkb_sol_CreateOtp."
                }
              },
              "required": [
                "email",
                "otp"
              ]
            }
          }
        }
      },
      "actions": {
        "Main_Flow": {
          "type": "Scope",
          "description": "All main flow logic. Business errors (INVALID_CODE, LOCKED) use Response + Terminate(Succeeded) here and never reach Handle_Flow_Error; only technical failures bubble up. Every Response returns HTTP 200 - see RECIPE.md 'H1'.",
          "actions": {
            "Validate_Input": {
              "type": "If",
              "description": "Guard: reject missing/malformed input before touching any data. Returns 200 + an errorCode, then Terminate(Succeeded) so Handle_Flow_Error does NOT run — invalid input is not a bug.",
              "expression": "@or(empty(coalesce(triggerBody()?['email'], '')), not(contains(coalesce(triggerBody()?['email'], ''), '@')), not(equals(length(coalesce(triggerBody()?['otp'], '')), 6)))",
              "actions": {
                "Respond_invalid_input": {
                  "type": "Response",
                  "description": "Return INVALID_INPUT for a missing/malformed email or an OTP that is not exactly 6 characters. HTTP 200 - see below.",
                  "inputs": {
                    "statusCode": 200,
                    "headers": {
                      "Content-Type": "application/json"
                    },
                    "body": {
                      "errorCode": "INVALID_INPUT"
                    }
                  },
                  "runAfter": {}
                },
                "Terminate_after_invalid_input": {
                  "type": "Terminate",
                  "description": "Stop the flow cleanly — no error email.",
                  "inputs": {
                    "runStatus": "Succeeded"
                  },
                  "runAfter": {
                    "Respond_invalid_input": ["Succeeded"]
                  }
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {}
            },
            "IMPLEMENT_Get_OTP_Record": {
              "type": "OpenApiConnection",
              "description": "Retrieve the stored OTP record for this email. [IMPLEMENT]: (1) replace entityName with your OTP table plural logical name (e.g. smkb_sol_otprequests). (2) replace smkb_sol_email in $filter with your email field name. Returns at most 1 record.",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps_[yourid]",
                  "operationId": "ListRecords",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "[IMPLEMENT]: smkb_sol_otprequests",
                  "$filter": "[IMPLEMENT]: smkb_sol_email eq '@{triggerBody()?[''email'']}'",
                  "$top": 1
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "Validate_Input": ["Succeeded"]
              }
            },
            "If_OTP_Not_Found": {
              "type": "If",
              "description": "No OTP record for this email. Returns the SAME generic INVALID_CODE as a wrong code, on purpose: a distinct code confirms whether the email is registered. Do NOT split this back into NOT_FOUND. See RECIPE.md 'H1'.",
              "expression": "@equals(length(body('IMPLEMENT_Get_OTP_Record')?['value']), 0)",
              "actions": {
                "Respond_not_found": {
                  "type": "Response",
                  "description": "Return the generic invalid-code response (same shape and code as a wrong OTP).",
                  "inputs": {
                    "statusCode": 200,
                    "headers": {
                      "Content-Type": "application/json"
                    },
                    "body": {
                      "errorCode": "INVALID_CODE"
                    }
                  },
                  "runAfter": {}
                },
                "Terminate_not_found": {
                  "type": "Terminate",
                  "description": "Stop cleanly — no error email.",
                  "inputs": {
                    "runStatus": "Succeeded"
                  },
                  "runAfter": {
                    "Respond_not_found": ["Succeeded"]
                  }
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "IMPLEMENT_Get_OTP_Record": ["Succeeded"]
              }
            },
            "If_Account_Locked": {
              "type": "If",
              "description": "Account is locked after 5 failed attempts — refuse before even comparing the OTP. [IMPLEMENT]: replace 'smkb_sol_attempts' with your actual attempts field name in the OTP table.",
              "expression": "@greaterOrEquals(coalesce(first(body('IMPLEMENT_Get_OTP_Record')?['value'])?['smkb_sol_attempts'], 0), 5)",
              "actions": {
                "Respond_locked": {
                  "type": "Response",
                  "description": "Return LOCKED. Word the client-facing message about the ATTEMPT STATE (\"too many attempts, try again later\"), never about the account - \"this account is locked\" confirms the account exists.",
                  "inputs": {
                    "statusCode": 200,
                    "headers": {
                      "Content-Type": "application/json"
                    },
                    "body": {
                      "errorCode": "LOCKED"
                    }
                  },
                  "runAfter": {}
                },
                "Terminate_locked": {
                  "type": "Terminate",
                  "description": "Stop cleanly — no error email.",
                  "inputs": {
                    "runStatus": "Succeeded"
                  },
                  "runAfter": {
                    "Respond_locked": ["Succeeded"]
                  }
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "If_OTP_Not_Found": ["Succeeded"]
              }
            },
            "IMPLEMENT_PLACEHOLDER": {
              "type": "Compose",
              "description": "[IMPLEMENT - BUSINESS LOGIC] Replace this Compose with the real OTP validation: expiry check, compare, increment attempts, delete the row on success, look up the user. Every step and the security rules: RECIPE.md 'H1'.",
              "inputs": "[IMPLEMENT]",
              "runAfter": {
                "If_Account_Locked": ["Succeeded"]
              }
            },
            "Compose_Generate_Auth_Token": {
              "type": "Compose",
              "description": "Generate a random auth token. guid() produces a UUID-4 format string — cryptographically suitable as an opaque session token.",
              "inputs": "@guid()",
              "runAfter": {
                "IMPLEMENT_PLACEHOLDER": ["Succeeded"]
              }
            },
            "IMPLEMENT_Create_Auth_Session": {
              "type": "OpenApiConnection",
              "description": "Create a session row in the Dataverse sessions table. [IMPLEMENT] Replace entityName with your session table's plural name and the four placeholder field names with yours; set the user id from IMPLEMENT_PLACEHOLDER. See RECIPE.md 'H1'.",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps_[yourid]",
                  "operationId": "CreateRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "[IMPLEMENT]: smkb_sol_sessions",
                  "item/smkb_sol_token":      "@outputs('Compose_Generate_Auth_Token')",
                  "item/smkb_sol_email":      "@triggerBody()?['email']",
                  "item/smkb_sol_expires_at": "@addHours(utcNow(), 1)",
                  "item/[IMPLEMENT]:smkb_sol_userid": "[IMPLEMENT]: user record ID from IMPLEMENT_PLACEHOLDER — e.g. @outputs('Get_user_record')?['body/smkb_sol_userid']"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "Compose_Generate_Auth_Token": ["Succeeded"]
              }
            },
            "Respond_to_PowerPages": {
              "type": "Response",
              "description": "Return the authenticated user record and auth token to the Power Pages caller. [IMPLEMENT]: replace inviteeId/firstName/lastName body fields with your actual user record expressions.",
              "inputs": {
                "statusCode": 200,
                "headers": {
                  "Content-Type": "application/json"
                },
                "body": {
                  "inviteeId":          "[IMPLEMENT]: e.g. @outputs('IMPLEMENT_Get_user_record')?['body/smkb_sol_userid']",
                  "firstName":          "[IMPLEMENT]: e.g. @outputs('IMPLEMENT_Get_user_record')?['body/smkb_sol_firstname']",
                  "lastName":           "[IMPLEMENT]: e.g. @outputs('IMPLEMENT_Get_user_record')?['body/smkb_sol_lastname']",
                  "email":              "[IMPLEMENT]: e.g. @triggerBody()?['email']",
                  "authToken":          "@outputs('Compose_Generate_Auth_Token')",
                  "authTokenExpiresAt": "@addHours(utcNow(), 1)"
                }
              },
              "runAfter": {
                "IMPLEMENT_Create_Auth_Session": ["Succeeded"]
              }
            }
          },
          "runAfter": {}
        },
        "Handle_Flow_Error": {
          "type": "Scope",
          "description": "Error handler — runs ONLY on unexpected technical failures (unhandled exception in Main_Flow). Business errors (INVALID_CODE, LOCKED) use Terminate(Succeeded) inside Main_Flow and never reach here.",
          "actions": {
            "Check_Error_Emails_Configured": {
              "type": "If",
              "description": "Only send the error email if smkb_sol_FlowErrorEmails is configured. Skipping silently when the env var is empty avoids spurious SendEmailV2 failures that would add noise to every error handler run.",
              "expression": "@not(empty(trim(parameters('ERROR_EMAILS (smkb_sol_FlowErrorEmails)'))))",
              "actions": {
                "Send_error_notification": {
                  "type": "OpenApiConnection",
                  "description": "Send error alert to all addresses in smkb_sol_FlowErrorEmails (semicolon-separated String env var).",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_office365_[yourid]",
                      "operationId": "SendEmailV2",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                    },
                    "parameters": {
                      "emailMessage/From": "[sol]NoReply@yourdomain.com",
                      "emailMessage/To": "@parameters('ERROR_EMAILS (smkb_sol_FlowErrorEmails)')",
                      "emailMessage/Subject": "@concat('(', toUpper(parameters('ENVIRONMENT_NAME (smkb_sol_EnvironmentName)')), ') [ERROR] smkb_sol_CheckOtp failed')",
                      "emailMessage/Body": "@concat('<p>The flow <strong>smkb_sol_CheckOtp</strong> failed unexpectedly in the <strong>', parameters('ENVIRONMENT_NAME (smkb_sol_EnvironmentName)'), '</strong> environment.</p><p><strong>Triggered by:</strong> ', coalesce(triggerBody()?['email'], '(unknown)'), '</p><p><strong>Run ID:</strong> ', workflow()['run']['name'], '</p><p>Open Power Automate &#8594; Cloud flows &#8594; smkb_sol_CheckOtp &#8594; Run history to investigate.</p>')",
                      "emailMessage/Importance": "High"
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runAfter": {}
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {}
            },
            "Respond_with_error": {
              "type": "Response",
              "description": "Always return a response so the Power Pages caller does not hang.",
              "inputs": {
                "statusCode": 200,
                "headers": {
                  "Content-Type": "application/json"
                },
                "body": {
                  "errorCode": "ERROR"
                }
              },
              "runAfter": {
                "Check_Error_Emails_Configured": ["Succeeded", "Failed", "Skipped"]
              }
            }
          },
          "runAfter": {
            "Main_Flow": [
              "Failed",
              "TimedOut",
              "Skipped"
            ]
          }
        }
      }
    }
  }
}
